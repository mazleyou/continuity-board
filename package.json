{
  "name": "continuity-board",
  "version": "0.1.0",
  "description": "Open-source 6-cut storyboard that keeps one character consistent, preserves approved cuts and fixes only the wrong ones — powered by ComfyUI + FLUX.2 [klein] 4B.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "node server/index.ts",
    "prestart:mock": "node scripts/check-node.mjs",
    "start:mock": "CB_BACKEND=mock node server/index.ts",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preworkflows": "node scripts/check-node.mjs",
    "workflows": "node scripts/export-workflows.ts",
    "presmoke:comfy": "node scripts/check-node.mjs",
    "smoke:comfy": "node scripts/smoke-comfy.ts",
    "prereport": "node scripts/check-node.mjs",
    "report": "node scripts/eval-report.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
